---
import SiteHeader from '../components/SiteHeader'
import '../styles/editorial.css'
interface Props {title:string;description?:string;image?:string}
const {title,description='Expedientes, testimonios y fuentes del archivo Paranormis.',image}=Astro.props
const canonical=new URL(Astro.url.pathname,Astro.url.origin).href
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#080908"/><title>{title} — Paranormis</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:locale" content="es_CO"/><meta property="og:site_name" content="Paranormis"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>{image&&<><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/></>}</head><body><SiteHeader active="discover"/><main class="editorial-main"><slot/></main><footer class="editorial-footer">PARANORMIS · Archivo editorial en español<br/>Fuentes documentadas, relatos por investigar.</footer></body></html>
