---
import Layout from '../../layouts/EditorialLayout.astro'
import CaseActions from '../../components/CaseActions'
import {sanityClient} from '../../lib/sanity'
import {CASES_QUERY,casePath,type EditorialCase} from '../../lib/editorial'
import {candelariaSource,genericImage,candelariaStops} from '../../data/candelariaStops'
let cases:EditorialCase[]=[]
let failed=false
try {cases=await sanityClient.fetch<EditorialCase[]>(CASES_QUERY)} catch {failed=true;Astro.response.status=503}
---
<Layout title="Recorrido por Colombia"><a class="editorial-link" href="/explorar">← Explorar expedientes</a><header class="editorial-intro"><p class="editorial-eyebrow">Recorrido virtual / Colombia</p><h1>Rutas de lo<br/>inexplicable.</h1><p>Un viaje de archivo por cinco relatos registrados en distintas ciudades, con una ruta complementaria de siete lugares e historias de La Candelaria.</p><p class="editorial-note">Es un recorrido digital. Las ubicaciones se presentan como referencias aproximadas; los relatos y leyendas se atribuyen a sus fuentes y no se presentan como hechos comprobados. No es una invitación a visitar propiedades.</p></header>
{cases.map((c,index)=><section class="editorial-panel editorial-stop"><p class="editorial-eyebrow">Parada {String(index+1).padStart(2,'0')} / {c.city||c.region?.name} · {c.creature?.name}</p><h2>{c.title}</h2><p>{c.freeformDescription}</p><p class="editorial-note">Transcripción editorial del relato.</p><CaseActions id={c._id} title={c.title} text={c.narrative||c.freeformDescription} client:load/><a class="editorial-link" href={casePath(c._id)}>Consultar fecha, ubicación y fuentes ↗</a></section>)}
<section class="candelaria-route" aria-labelledby="candelaria-title"><header><p class="editorial-eyebrow">Anexo / Bogotá · La Candelaria</p><h2 id="candelaria-title">Siete lugares, siete relatos.</h2><p>Esta ruta se basa en el artículo de Colombia Visible, que recopila leyendas y versiones transmitidas por un guía y residentes. Una de las paradas aporta contexto histórico, sin atribuir una aparición concreta al lugar.</p><p class="editorial-note">Ilustración genérica del archivo; no representa los lugares ni documenta los relatos.</p></header><div class="candelaria-stops">{candelariaStops.map((stop,index)=><article id={`candelaria-stop-${String(index+1).padStart(2,'0')}`} class="editorial-panel candelaria-stop"><img src={genericImage} alt="Ilustración genérica del archivo Paranormis" loading="lazy"/><div><p class="editorial-eyebrow">Lugar {String(index+1).padStart(2,'0')} / La Candelaria · {stop.kind}</p><h3>{stop.title}</h3><p>{stop.text}</p><a class="editorial-link" href={candelariaSource} target="_blank" rel="noopener noreferrer">Leer el artículo de Colombia Visible ↗</a></div></article>)}</div></section>
{!cases.length&&<p>{failed?'No pudimos consultar los expedientes del recorrido. La ruta de La Candelaria sigue disponible.':'El recorrido todavía no tiene expedientes publicados.'}</p>}
</Layout>
<style>
  .candelaria-route{margin-top:76px;border-top:1px solid #302f29;padding-top:42px}
  .candelaria-route>header{max-width:760px;margin-bottom:30px}
  .candelaria-route>header h2{font-size:clamp(1.45rem,2.5vw,2rem)}
  .candelaria-stops{display:grid;gap:18px}
  .candelaria-stop{display:grid;grid-template-columns:180px minmax(0,1fr);gap:24px;align-items:center;max-width:900px}
  .candelaria-stop img{width:100%;height:210px;object-fit:cover;object-position:center 35%;border:1px solid #302f29;background:#10110f;filter:saturate(.55) brightness(.82)}
  .candelaria-stop h3{margin:.8rem 0;font-family:'Merriweather',Georgia,serif;font-size:1.12rem;line-height:1.45}
  .candelaria-stop .editorial-link{display:inline-block;margin-top:.35rem}
  @media(max-width:600px){.candelaria-stop{grid-template-columns:1fr;gap:16px}.candelaria-stop img{height:190px;object-position:center 30%}}
</style>
