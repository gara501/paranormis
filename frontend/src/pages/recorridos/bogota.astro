---
import Layout from '../../layouts/EditorialLayout.astro'
import CaseActions from '../../components/CaseActions'
import {sanityClient} from '../../lib/sanity'
import {CASES_QUERY,casePath,type EditorialCase} from '../../lib/editorial'
let cases:EditorialCase[]=[]
let failed=false
try {cases=(await sanityClient.fetch<EditorialCase[]>(CASES_QUERY)).filter(c=>c.city==='Bogotá').sort((a,b)=>a.title.localeCompare(b.title,'es'))} catch {failed=true;Astro.response.status=503}
---
<Layout title="Bogotá, después del cierre"><a class="editorial-link" href="/explorar">← Explorar expedientes</a><header class="editorial-intro"><p class="editorial-eyebrow">Recorrido virtual / Bogotá</p><h1>Bogotá, después<br/>del cierre.</h1><p>Del teatro a las calles del norte: una lectura de los relatos que acompañan la ciudad. Escucha cada parada y consulta su expediente.</p><p class="editorial-note">Los puntos son referencias aproximadas. Esta experiencia no propone ingresar a propiedades ni visitar lugares de riesgo.</p></header>
{cases.map((c,index)=><section class="editorial-panel editorial-stop"><p class="editorial-eyebrow">Parada {String(index+1).padStart(2,'0')} / {c.creature?.name}</p><h2>{c.title}</h2><p>{c.freeformDescription}</p><p class="editorial-note">El texto anterior es la transcripción de la lectura.</p><CaseActions id={c._id} title={c.title} text={c.freeformDescription} client:load/><a class="editorial-link" href={casePath(c._id)}>Consultar fecha, ubicación y fuentes ↗</a></section>)}
{!cases.length&&<p>{failed?'No pudimos consultar el recorrido. Inténtalo más tarde.':'El recorrido todavía no tiene expedientes publicados.'}</p>}
</Layout>
