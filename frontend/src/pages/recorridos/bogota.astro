---
import Layout from '../../layouts/EditorialLayout.astro'
import CaseActions from '../../components/CaseActions'
import {sanityClient} from '../../lib/sanity'
import {CASES_QUERY,casePath,type EditorialCase} from '../../lib/editorial'
let cases:EditorialCase[]=[]
let failed=false
try {cases=await sanityClient.fetch<EditorialCase[]>(CASES_QUERY)} catch {failed=true;Astro.response.status=503}
const candelariaSource='https://colombiavisible.com/7-lugares-con-historias-paranormales-en-el-barrio-la-candelaria-de-bogota/'
const genericImage='https://cdn.sanity.io/images/en0s05um/production/4cdd6608fedda4fb30cc5c100d533f54d173dae9-1122x1402.png'
const candelariaStops=[
  {title:'El venado de oro de los Cerros Orientales',kind:'Leyenda de tesoro · tradición local',text:'Colombia Visible recoge la leyenda de Diego Barreto, un aventurero portugués que habría encontrado un venado de oro en una cueva de los cerros a finales del siglo XVII. La historia cuenta que dejó parte del tesoro y nunca regresó por él. No es un avistamiento documentado: es una leyenda sobre un tesoro cuya búsqueda persiste en el relato popular.'},
  {title:'Los sonidos de la Calle del Sol',kind:'Relatos atribuidos a residentes',text:'En el terreno donde hoy funciona el conjunto residencial Calle del Sol habría operado el Servicio de Inteligencia Colombiana durante el gobierno de Gustavo Rojas Pinilla. El artículo refiere versiones sobre torturas en sus sótanos y cuenta que residentes han dicho escuchar golpes, carcajadas y gemidos de madrugada. La nota no identifica a los residentes ni aporta registros independientes de esos sonidos.'},
  {title:'Las esculturas que cobrarían vida',kind:'Leyenda urbana · Jorge Olave',text:'El escultor Jorge Olave creó en 1996 la serie de 33 figuras “Héroes del día a día”, instaladas en tejados de La Candelaria. Colombia Visible relaciona la muerte de Olave en 2013 con la leyenda de que algunas esculturas cobran vida durante la noche. El artículo no atribuye esa afirmación a un testigo identificado.'},
  {title:'La Clínica Central y el 9 de abril',kind:'Contexto histórico · sin aparición atribuida',text:'La antigua Clínica Central —hoy sede de la Universidad Autónoma de Colombia— recibió a Jorge Eliécer Gaitán después del atentado del 9 de abril de 1948. El artículo relata su muerte y los hechos violentos del Bogotazo, pero no describe aquí una aparición o un fenómeno paranormal concreto. Se incluye como contexto histórico del recorrido.'},
  {title:'Los lamentos del Hospital de San Pedro',kind:'Relato oral referido por un guía',text:'El claustro, fundado en 1564 y usado como hospital, aparece asociado a relatos de dolor, desesperación y gritos. Según Juan Carlos Arbeláez, guía del tour citado por el artículo, vecinos han sentido u oído esas manifestaciones. La fuente disponible transmite el relato a través del guía; no individualiza a los vecinos ni verifica los episodios.'},
  {title:'La aparición de Raimundo Russi',kind:'Leyenda urbana · relato atribuido a una obra',text:'Raimundo Russi, abogado fusilado en 1851 tras ser acusado de liderar una banda criminal, sería visto —según la tradición descrita— en la carrera 2 entre calles 9 y 10, reclamando su inocencia. La nota atribuye esta versión al texto “Fantasmagorías bogotanas”, de Gabriel Eljaiek Rodríguez. La aparición sigue siendo un relato, no un hecho comprobado.'},
  {title:'La casa de La estrategia del caracol',kind:'Relato atribuido a sus administradores',text:'La casa, construida entre 1850 y 1860 y conocida por la película de 1993, funciona hoy como restaurante. Colombia Visible cuenta que los hermanos que la administran relataron haber visto un espectro bajar por una escalera. También mencionan golpes, objetos pesados que caen y siluetas vistas en distintos momentos. El texto no precisa fechas para esos episodios.'},
]
---
<Layout title="Recorrido por Colombia"><a class="editorial-link" href="/explorar">← Explorar expedientes</a><header class="editorial-intro"><p class="editorial-eyebrow">Recorrido virtual / Colombia</p><h1>Rutas de lo<br/>inexplicable.</h1><p>Un viaje de archivo por cinco relatos registrados en distintas ciudades, con una ruta complementaria de siete lugares e historias de La Candelaria.</p><p class="editorial-note">Es un recorrido digital. Las ubicaciones se presentan como referencias aproximadas; los relatos y leyendas se atribuyen a sus fuentes y no se presentan como hechos comprobados. No es una invitación a visitar propiedades.</p></header>
{cases.map((c,index)=><section class="editorial-panel editorial-stop"><p class="editorial-eyebrow">Parada {String(index+1).padStart(2,'0')} / {c.city||c.region?.name} · {c.creature?.name}</p><h2>{c.title}</h2><p>{c.freeformDescription}</p><p class="editorial-note">Transcripción editorial del relato.</p><CaseActions id={c._id} title={c.title} text={c.narrative||c.freeformDescription} client:load/><a class="editorial-link" href={casePath(c._id)}>Consultar fecha, ubicación y fuentes ↗</a></section>)}
<section class="candelaria-route" aria-labelledby="candelaria-title"><header><p class="editorial-eyebrow">Anexo / Bogotá · La Candelaria</p><h2 id="candelaria-title">Siete lugares, siete relatos.</h2><p>Esta ruta se basa en el artículo de Colombia Visible, que recopila leyendas y versiones transmitidas por un guía y residentes. Una de las paradas aporta contexto histórico, sin atribuir una aparición concreta al lugar.</p><p class="editorial-note">Ilustración genérica del archivo; no representa los lugares ni documenta los relatos.</p></header><div class="candelaria-stops">{candelariaStops.map((stop,index)=><article class="editorial-panel candelaria-stop"><img src={genericImage} alt="Ilustración genérica del archivo Paranormis" loading="lazy"/><div><p class="editorial-eyebrow">Lugar {String(index+1).padStart(2,'0')} / La Candelaria · {stop.kind}</p><h3>{stop.title}</h3><p>{stop.text}</p><a class="editorial-link" href={candelariaSource} target="_blank" rel="noopener noreferrer">Leer el artículo de Colombia Visible ↗</a></div></article>)}</div></section>
{!cases.length&&<p>{failed?'No pudimos consultar los expedientes del recorrido. La ruta de La Candelaria sigue disponible.':'El recorrido todavía no tiene expedientes publicados.'}</p>}
</Layout>
<style>
  .candelaria-route{margin-top:76px;border-top:1px solid #302f29;padding-top:42px}
  .candelaria-route>header{max-width:760px;margin-bottom:30px}
  .candelaria-route>header h2{font-size:clamp(1.45rem,2.5vw,2rem)}
  .candelaria-stops{display:grid;gap:18px}
  .candelaria-stop{display:grid;grid-template-columns:180px minmax(0,1fr);gap:24px;align-items:center;max-width:900px}
  .candelaria-stop img{width:100%;height:210px;object-fit:cover;object-position:center 35%;border:1px solid #302f29;background:#10110f;filter:saturate(.55) brightness(.82)}
  .candelaria-stop h3{margin:.8rem 0;font-family:'Merriweather',Georgia,serif;font-size:1.12rem;line-height:1.45}
  .candelaria-stop .editorial-link{display:inline-block;margin-top:.35rem}
  @media(max-width:600px){.candelaria-stop{grid-template-columns:1fr;gap:16px}.candelaria-stop img{height:190px;object-position:center 30%}}
</style>
