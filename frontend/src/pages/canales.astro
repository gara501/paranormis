---
import Layout from '../layouts/EditorialLayout.astro'

const channels = [
  {handle: 'chimbadas.raras', url: 'https://www.tiktok.com/@chimbadas.raras'},
  {handle: 'historiasyespantos', url: 'https://www.tiktok.com/@historiasyespantos'},
  {handle: 'anapaolaamor', url: 'https://www.tiktok.com/@anapaolaamor'},
  {handle: 'unlugaroscuro666', url: 'https://www.tiktok.com/@unlugaroscuro666'},
]
---

<Layout title="Canales paranormales" description="Descubre canales independientes que exploran relatos y fenómenos paranormales." active="channels">
  <header class="explore-intro">
    <p class="editorial-eyebrow">Frecuencias externas / Archivo abierto</p>
    <h1>Canales paranormales</h1>
    <p>Otras voces que exploran lo extraño. Abre cada señal para visitar su perfil en TikTok.</p>
  </header>
  <section class="explore-secondary explore-channel-section" aria-label="Directorio de canales paranormales">
    <div class="explore-channel-heading">
      <div>
        <p class="editorial-eyebrow">Sintonía abierta / Directorio</p>
        <h2>Señales independientes</h2>
        <p>Perfiles externos seleccionados para ampliar las historias que encuentras en Paranormis.</p>
      </div>
      <span class="explore-channel-stamp" aria-hidden="true">SINTONÍA<br/>ABIERTA</span>
    </div>
    <div class="explore-channels">
      {channels.map(({handle, url}, index) => (
        <a class="explore-channel-card" href={url} target="_blank" rel="noopener noreferrer">
          <span class="channel-orbit" aria-hidden="true"><i/><b>✳</b></span>
          <span class="explore-channel-card__top">
            <span>SEÑAL {String(index + 1).padStart(2, '0')} / TIKTOK</span>
            <span class="channel-live"><i/> DIRECTORIO</span>
          </span>
          <strong>@{handle}</strong>
          <span class="explore-channel-card__bottom"><span>CANAL EXTERNO</span><span>ABRIR FRECUENCIA ↗</span></span>
        </a>
      ))}
    </div>
    <aside class="explore-channel-invitation">
      <span class="explore-channel-invitation__mark" aria-hidden="true">✦</span>
      <div>
        <p class="editorial-eyebrow">Espacio para nuevas voces</p>
        <h3>Una frecuencia invitada puede aparecer aquí.</h3>
        <p>Este directorio está preparado para destacar canales independientes en futuras colaboraciones.</p>
      </div>
      <span class="explore-channel-invitation__label">FUTURA<br/>SEÑAL</span>
    </aside>
  </section>
</Layout>
